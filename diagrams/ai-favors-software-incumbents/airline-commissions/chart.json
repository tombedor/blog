{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "./data.csv", "format": "csv" },
  "mark": "line",
  "title": {
    "text": "Airline Commissions Fell Before Online Travel Scaled",
    "subtitle": "Representative U.S. travel-agent airline commission rate; event markers show OTA launch timing."
  },
  "annotations": [
    { "x": "1996", "label": "Travelocity + Expedia" },
    { "x": "1998", "label": "Priceline" },
    { "x": "2002", "label": "Base commissions go to zero", "dx": -130 }
  ],
  "encoding": {
    "x": { "field": "year", "type": "ordinal", "title": "Year" },
    "y": { "field": "value", "type": "quantitative", "title": "Commission rate (%)" },
    "color": {
      "field": "metric",
      "type": "nominal",
      "legend": null,
      "scale": { "domain": ["Travel-agent airline commission rate"] }
    }
  }
}
