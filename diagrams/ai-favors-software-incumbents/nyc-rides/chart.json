{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "./data.csv", "format": "csv" },
  "mark": "line",
  "title": {
    "text": "Uber Expanded NYC Ride Volume",
    "subtitle": "Daily trips per 1,000 residents. TLC trip data and Census population estimates; 2026 through April."
  },
  "encoding": {
    "x": { "field": "year", "type": "ordinal", "title": "Year" },
    "y": { "field": "daily_trips_per_1000", "type": "quantitative", "title": "Daily trips per 1,000 residents" },
    "color": {
      "field": "service",
      "type": "nominal",
      "scale": { "domain": ["Yellow taxi", "Uber", "Total"] }
    }
  }
}
