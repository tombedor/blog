#         # Prevent MIME sniffing
#         X-Content-Type-Options "nosniff"
#         # Enable XSS protection
#         X-XSS-Protection "1; mode=block"
#         # Referrer policy
#         Referrer-Policy "strict-origin-when-cross-origin"
#     }
#
#     # Logging
#     log {
#         output file /data/logs/analytics.log
#         format json
#     }
# }
