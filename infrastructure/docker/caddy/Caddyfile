# Caddyfile for Umami and Listmonk
# Replace the domains below with your actual domains
# Or use IP:port for testing without domains

# Configuration without domains (for IP-based access)
:3000 {
    reverse_proxy umami:3000
}

:9000 {
    reverse_proxy listmonk:9000
}

# Configuration with domains (automatic HTTPS)
# Uncomment and configure these when you're ready to use domains:

# {$ANALYTICS_DOMAIN:analytics.example.com} {
#     reverse_proxy umami:3000
#
#     # Enable compression
#     encode gzip zstd
#
#     # Security headers
#     header {
#         # Enable HSTS
#         Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
