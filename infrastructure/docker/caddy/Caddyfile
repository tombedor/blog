{$ANALYTICS_DOMAIN:analytics.example.com} {
    reverse_proxy umami:3000

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

{$LISTMONK_DOMAIN:newsletter.example.com} {
    reverse_proxy listmonk:9000

    encode gzip zstd

    # Allow subscription API calls from the main blog domain
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "https://tombedor.dev"
        header Access-Control-Allow-Methods "POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type"
        respond 204
    }

    header /api/public/* {
        Access-Control-Allow-Origin "https://tombedor.dev"
        Access-Control-Allow-Methods "POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type"
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
