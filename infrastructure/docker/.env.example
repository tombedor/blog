# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Umami Configuration
# Generate a random secret: openssl rand -hex 32
UMAMI_APP_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Domain Configuration (for Caddy)
# Leave empty or comment out if using IP-based access
ANALYTICS_DOMAIN=analytics.yourdomain.com
LISTMONK_DOMAIN=newsletter.yourdomain.com

# Listmonk SMTP (SendGrid)
# 1. Create a SendGrid account at https://sendgrid.com
# 2. Create an API key with "Mail Send" permissions at https://app.sendgrid.com/settings/api_keys
# 3. Verify your sender domain at https://app.sendgrid.com/settings/sender_auth
LISTMONK_app__smtp_address=smtp.sendgrid.net
LISTMONK_app__smtp_port=587
LISTMONK_app__smtp_auth_protocol=login
LISTMONK_app__smtp_username=apikey
LISTMONK_app__smtp_password=SG.CHANGE_ME_TO_YOUR_SENDGRID_API_KEY
LISTMONK_app__smtp_from_address=newsletter@yourdomain.com
