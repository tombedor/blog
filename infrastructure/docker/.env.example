# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Umami Configuration
# Generate a random secret: openssl rand -hex 32
UMAMI_APP_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Domain Configuration (for Caddy)
# Leave empty or comment out if using IP-based access
ANALYTICS_DOMAIN=analytics.yourdomain.com
LISTMONK_DOMAIN=newsletter.yourdomain.com
