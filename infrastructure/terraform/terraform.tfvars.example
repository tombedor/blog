# DigitalOcean API Token
# Get from: https://cloud.digitalocean.com/account/api/tokens
do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxx"

# SSH Key Name
# Must match a key name in your DigitalOcean account
# View keys at: https://cloud.digitalocean.com/account/security
ssh_key_name = "your-ssh-key-name"

# Droplet Configuration
droplet_name = "blog-analytics"
region       = "nyc3"  # Options: nyc1, nyc3, sfo3, sgp1, lon1, fra1, tor1, blr1
droplet_size = "s-1vcpu-2gb"  # $12/mo - sufficient for most blogs

# Security: SSH Access Control
# Replace this example with your current public IP as a /32 CIDR.
ssh_allowed_ips = ["203.0.113.10/32"]

# Tags
tags = ["analytics", "blog", "production"]

# Domain Configuration (optional)
# Leave empty "" if not using DigitalOcean DNS
domain = ""  # e.g., "yourdomain.com"

# Subdomains (only used if domain is set)
analytics_subdomain = ""  # e.g., "analytics" for analytics.yourdomain.com
listmonk_subdomain  = ""  # e.g., "newsletter" for newsletter.yourdomain.com
