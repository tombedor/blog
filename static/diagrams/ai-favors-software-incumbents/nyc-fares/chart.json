{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "./data.csv", "format": "csv" },
  "mark": "line",
  "title": {
    "text": "Ride-Hail Did Not Stay the Cheap Option",
    "subtitle": "Average passenger fare per trip, annualized from TLC monthly data via Todd Schneider's dashboard API."
  },
  "encoding": {
    "x": { "field": "year", "type": "ordinal", "title": "Year" },
    "y": { "field": "average_fare", "type": "quantitative", "title": "Average fare ($)" },
    "color": {
      "field": "service",
      "type": "nominal",
      "scale": { "domain": ["Yellow taxi", "Uber"] }
    }
  }
}
